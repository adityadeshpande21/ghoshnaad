{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ghosh-notation/1",
  "title": "Ghosh notation — source (authoring) file",
  "description": "One file per rachana, lesson or udghosh. Each instrument part is a list of lines written in the line grammar described in README.md (close to the printed books). src/parser.js turns this into the expanded runtime model.",
  "type": "object",
  "required": [
    "format",
    "id",
    "title",
    "section",
    "parts"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "ghosh-notation/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Stable slug, e.g. \"ajey\". Shared by all parts of the same rachana."
    },
    "kind": {
      "enum": [
        "rachana",
        "udghosh",
        "lesson",
        "exercise"
      ],
      "default": "rachana"
    },
    "title": {
      "type": "object",
      "required": [
        "dev"
      ],
      "additionalProperties": false,
      "properties": {
        "dev": {
          "type": "string",
          "description": "Name as printed, Devanagari"
        },
        "rom": {
          "type": "string",
          "description": "Romanised name for search"
        },
        "alt": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other spellings seen in other books, e.g. प्रशान्ति / प्रशांति"
        }
      }
    },
    "section": {
      "enum": [
        "prachalan-shankh",
        "prachalan-vanshi",
        "mand-shankh",
        "mand-vanshi",
        "naimittik",
        "lessons"
      ]
    },
    "complete": {
      "type": "boolean",
      "default": true,
      "description": "false for excerpts"
    },
    "raga": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Raga in brackets after the name, e.g. बागेश्री"
        },
        "aroha": {
          "type": "string",
          "description": "Swaras in line grammar, e.g. \"स ग_ म ध नि_ स'\""
        },
        "avaroha": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "aroha"
          ]
        }
      ]
    },
    "text": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Verse or mantra printed above the notation (e.g. ध्वजारोपणम्)"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Usage rules and transcriber notes for the whole piece"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "shankh",
          "vanshi",
          "anak",
          "panav",
          "kharjanak",
          "tribhuj",
          "jhallari"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/part"
      }
    },
    "media": {
      "type": "array",
      "description": "Reference recordings (YouTube, audio files) for this piece",
      "items": {
        "type": "object",
        "required": [
          "type",
          "url"
        ],
        "properties": {
          "type": {
            "enum": [
              "video",
              "audio"
            ]
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Which parts are heard in the recording"
          },
          "start": {
            "type": "number",
            "description": "Seconds into the recording where the rachana begins (for sync)"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "usage": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Usage rules printed with the rachana (shown to players), e.g. when it may be played"
    },
    "standing": {
      "type": "boolean",
      "description": "Played standing (no marching steps), e.g. during ध्वजारोहण or a प्रणाम"
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "required": [
        "tala",
        "laya",
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "book": {
              "enum": [
                "anak",
                "shankh",
                "vanshi"
              ]
            },
            "page": {
              "type": "integer",
              "description": "Printed page number"
            },
            "pdfPage": {
              "type": "integer"
            },
            "edition": {
              "type": "integer"
            },
            "excerpt": {
              "type": "string"
            }
          }
        },
        "tala": {
          "type": "string",
          "description": "Opening tala: केरवा खेमटा दादरा झपताल रूपक एकताल त्रिताल (or kerva, khemta…)"
        },
        "laya": {
          "type": "integer",
          "minimum": 20,
          "maximum": 600,
          "description": "Matras per minute from the heading, e.g. 120 or 360"
        },
        "headingTala": {
          "type": "string",
          "description": "Tala text exactly as printed, e.g. \"खेमटा-३६० केरवा-१२०\""
        },
        "form": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "description": "Optional playback order by charan label or number, e.g. [\"ध्रुवपद\",\"1\",\"ध्रुवपद\"]. Default: charans in written order with their repeats."
        },
        "status": {
          "enum": [
            "draft",
            "checked",
            "verified"
          ],
          "default": "draft"
        },
        "transcribedBy": {
          "type": "string"
        },
        "checkedBy": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/line"
              }
            ]
          },
          "description": "One entry per printed line, in order."
        }
      }
    },
    "line": {
      "type": "object",
      "required": [
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "type": "string",
          "description": "The line in line grammar"
        },
        "pickup": {
          "type": "boolean",
          "description": "Right-aligned anacrusis printed before a charan (e.g. \"–प॒ ॥\"); played once before the next charan"
        },
        "lyrics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "One entry per matra in this line (\"\" for none)"
        },
        "hands": {
          "type": "string",
          "description": "One entry per slot: R, L, r/l (ghost, slashed label), . (none)"
        },
        "label": {
          "type": "string",
          "description": "Charan label, same as #label in the line"
        },
        "type": {
          "enum": [
            "prastav",
            "dhruv",
            "setu",
            "prarambhik",
            "normal"
          ],
          "description": "Charan role (प्रस्ताव पद, ध्रुव पद, सेतु पद)"
        },
        "players": {
          "type": "string",
          "description": "Who plays this charan, e.g. \"all\" or \"anuvadak\""
        },
        "note": {
          "type": "string",
          "description": "Footnote or instruction printed with this line"
        },
        "partial": {
          "type": "boolean",
          "description": "Line holds a deliberately short गण (e.g. a closing tag like ॥ स ऽ – ॥); skip the गण-size check"
        }
      }
    }
  }
}