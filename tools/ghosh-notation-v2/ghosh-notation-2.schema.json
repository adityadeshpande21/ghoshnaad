{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ghosh-notation/2",
  "title": "Ghosh notation v2 — structured tree for playback",
  "description": "piece → parts → charans → lines → gans → gats → matras → slots. Durations are implicit: a matra lasts 60/laya seconds (× span) and is shared by its slots in proportion to their weight w (default 1).",
  "type": "object",
  "required": [
    "format",
    "id",
    "title",
    "section",
    "parts"
  ],
  "properties": {
    "format": {
      "const": "ghosh-notation/2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "kind": {
      "enum": [
        "rachana",
        "udghosh",
        "lesson",
        "exercise"
      ]
    },
    "title": {
      "type": "object",
      "required": [
        "dev"
      ],
      "properties": {
        "dev": {
          "type": "string"
        },
        "rom": {
          "type": "string"
        },
        "alt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "section": {
      "enum": [
        "prachalan-shankh",
        "prachalan-vanshi",
        "mand-shankh",
        "mand-vanshi",
        "naimittik",
        "lessons"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "raga": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "aroha": {
          "type": "string"
        },
        "avaroha": {
          "type": "string"
        },
        "arohaNotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pitch"
          }
        },
        "avarohaNotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pitch"
          }
        }
      }
    },
    "tuning": {
      "type": "object",
      "properties": {
        "sa": {
          "type": "string",
          "description": "Reference Sa, e.g. \"C#4\" or \"277.18\""
        }
      }
    },
    "text": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "shankh",
          "vanshi",
          "anak",
          "panav",
          "kharjanak",
          "tribhuj",
          "jhallari"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/part"
      }
    },
    "media": {
      "type": "array",
      "description": "Reference recordings (YouTube, audio files) for this piece",
      "items": {
        "type": "object",
        "required": [
          "type",
          "url"
        ],
        "properties": {
          "type": {
            "enum": [
              "video",
              "audio"
            ]
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Which parts are heard in the recording"
          },
          "start": {
            "type": "number",
            "description": "Seconds into the recording where the rachana begins (for sync)"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "usage": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Usage rules printed with the rachana (shown to players), e.g. when it may be played"
    },
    "standing": {
      "type": "boolean",
      "description": "Played standing (no marching steps), e.g. during ध्वजारोहण or a प्रणाम"
    }
  },
  "$defs": {
    "tala": {
      "type": "object",
      "required": [
        "name",
        "key",
        "laya",
        "cycle",
        "ganSize"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "केरवा, खेमटा, दादरा, झपताल, रूपक, एकताल, त्रिताल"
        },
        "key": {
          "enum": [
            "kerva",
            "khemta",
            "dadra",
            "jhaptal",
            "rupak",
            "ektal",
            "tritaal"
          ]
        },
        "laya": {
          "type": "number",
          "description": "Matras per minute"
        },
        "cycle": {
          "type": "integer",
          "description": "Matras per आवर्तन; beat 1 is सम"
        },
        "ganSize": {
          "type": "integer",
          "description": "Matras per गण"
        },
        "gats": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          },
          "description": "गट sizes inside a गण, e.g. [3,3] for Khemta"
        },
        "stepMatras": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Matras per marching step (Kerva 1, Khemta 3); null when not marched"
        }
      }
    },
    "part": {
      "type": "object",
      "required": [
        "instrument",
        "tala",
        "charans"
      ],
      "properties": {
        "instrument": {
          "type": "string"
        },
        "source": {
          "type": [
            "object",
            "null"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "checked",
            "verified"
          ]
        },
        "tala": {
          "$ref": "#/$defs/tala"
        },
        "headingTala": {
          "type": "string"
        },
        "form": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "description": "Playback order by charan label or number; default is written order"
        },
        "charans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/charan"
          }
        }
      }
    },
    "charan": {
      "type": "object",
      "required": [
        "n",
        "repeat",
        "lines"
      ],
      "properties": {
        "n": {
          "type": "integer"
        },
        "label": {
          "type": "string",
          "description": "e.g. ध्रुवपद, 1, 2"
        },
        "type": {
          "enum": [
            "prastav",
            "dhruv",
            "setu",
            "prarambhik",
            "normal"
          ]
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "description": "Times played (:॥ = 2)"
        },
        "tala": {
          "$ref": "#/$defs/tala",
          "description": "Only when this charan changes tala"
        },
        "laya": {
          "type": "number",
          "description": "Only when this charan has its own laya (e.g. superscript १००)"
        },
        "players": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pickup": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/matra"
          },
          "description": "Played once before the first pass"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "endings": {
          "type": "object",
          "description": "क्रमभेद: pass n plays lines then endings[n]",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "object",
              "required": [
                "lines"
              ],
              "properties": {
                "lines": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/line"
                  }
                }
              }
            }
          }
        }
      }
    },
    "line": {
      "type": "object",
      "required": [
        "line",
        "gans"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "description": "Printed line number within the part"
        },
        "src": {
          "type": "string",
          "description": "Shorthand the line was compiled from (for editing and diffing)"
        },
        "gans": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/gan"
              },
              {
                "$ref": "#/$defs/yati"
              }
            ]
          }
        }
      }
    },
    "gan": {
      "type": "object",
      "required": [
        "gats"
      ],
      "properties": {
        "gats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gat"
          }
        },
        "short": {
          "type": "boolean",
          "description": "Deliberately shorter than the tala's गण (closing tag)"
        }
      }
    },
    "yati": {
      "type": "object",
      "required": [
        "yati",
        "span"
      ],
      "properties": {
        "yati": {
          "type": "integer",
          "description": "दीर्घ यति: rest for this many गण"
        },
        "span": {
          "type": "integer",
          "description": "= yati × ganSize matras"
        }
      }
    },
    "gat": {
      "type": "object",
      "required": [
        "matras"
      ],
      "properties": {
        "matras": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/matra"
          }
        }
      }
    },
    "matra": {
      "type": "object",
      "required": [
        "slots"
      ],
      "properties": {
        "beat": {
          "type": "integer",
          "description": "Position in the tala cycle, 1 = सम"
        },
        "group": {
          "type": "boolean",
          "description": "Book shows a bracket under this matra (slots share it)"
        },
        "span": {
          "type": "integer",
          "description": "Matras this cell lasts (cues); default 1"
        },
        "cue": {
          "type": "string",
          "description": "Spoken/sung text occupying the cell, e.g. ॐ, मंत्र"
        },
        "lyric": {
          "type": "string"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          }
        }
      }
    },
    "pitch": {
      "type": "object",
      "required": [
        "swara",
        "octave"
      ],
      "properties": {
        "swara": {
          "enum": [
            "S",
            "R",
            "G",
            "M",
            "P",
            "D",
            "N"
          ]
        },
        "octave": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        },
        "vikrit": {
          "type": "boolean",
          "description": "komal (R G D N) or tivra (M)"
        },
        "dev": {
          "type": "string"
        }
      }
    },
    "slot": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "note",
            "stroke",
            "hold",
            "rest"
          ]
        },
        "dev": {
          "type": "string",
          "description": "Display glyph as printed: ग, त्र, ऽ, –"
        },
        "swara": {
          "enum": [
            "S",
            "R",
            "G",
            "M",
            "P",
            "D",
            "N"
          ]
        },
        "octave": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2,
          "description": "-1 mandra, 0 madhya, 1 tara"
        },
        "vikrit": {
          "type": "boolean"
        },
        "stroke": {
          "enum": [
            "ta",
            "tha",
            "thra",
            "roll",
            "click",
            "dhvam",
            "dham",
            "tam",
            "jham"
          ]
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Relative share of the matra (default 1)"
        },
        "accent": {
          "type": "boolean",
          "description": "आघात ^"
        },
        "fermata": {
          "type": "boolean",
          "description": "लयभंग →"
        },
        "swell": {
          "enum": [
            "grow",
            "fade",
            "swell"
          ]
        },
        "slur": {
          "enum": [
            "start",
            "mid",
            "end",
            "single"
          ],
          "description": "निरंतर: no re-articulation after start"
        },
        "grace": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "कण-स्वर / grace strokes just before this slot"
        },
        "hand": {
          "type": "string",
          "description": "R, L, r, l (ghost)"
        },
        "uncertain": {
          "type": "boolean"
        }
      }
    }
  }
}