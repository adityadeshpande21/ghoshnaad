{
  "name": "ghoshnaad",
  "version": "2.0.0-dev",
  "private": true,
  "description": "Ghoshnaad \u2014 offline app for RSS Ghosh rachanas",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tools/run-tests.mjs \"tests/unit/*.test.mjs\" \"tests/golden/*.test.mjs\"",
    "build": "node build/build.mjs",
    "check": "node build/check-single-file.mjs dist/Ghoshnaad.html dist/index.html",
    "test:browser": "GHOSH_TARGET=dist playwright test",
    "test:browser:legacy": "GHOSH_TARGET=legacy playwright test",
    "verify": "npm run typecheck && npm run i18n:check && npm test && npm run build && npm run check && npm run test:dist && npm run test:browser",
    "golden:record": "node tests/golden/record.mjs",
    "legacy:verify": "node tools/legacy-split.mjs verify legacy/v1.1.0/index.html legacy/src/app && node tools/legacy-split.mjs verify legacy/tala-velresha.html legacy/src/tala-velresha",
    "test:dist": "node tools/run-tests.mjs \"tests/dist/*.test.mjs\"",
    "typecheck": "node tools/typecheck.mjs",
    "i18n:check": "node tools/i18n-check.mjs",
    "check:rachana": "node tools/check-rachana.mts",
    "i18n:export": "node tools/i18n-xlsx.mjs export",
    "i18n:import": "node tools/i18n-xlsx.mjs import"
  },
  "devDependencies": {
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/yatra-one": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
